{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.cjs",
              "hook",
              "user-prompt-submit"
            ],
            "statusMessage": "Recording turn context"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.cjs",
              "hook",
              "session-start"
            ],
            "statusMessage": "Delivering notes to self"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/cli.cjs",
              "hook",
              "stop"
            ],
            "statusMessage": "Checking the turn signed off"
          }
        ]
      }
    ]
  }
}
