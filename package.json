{
  "name": "self-expression",
  "version": "0.6.2",
  "description": "self-expression plugin for agents like claude opus, codex, gemini, and deepseek",
  "keywords": [
    "self-expression",
    "stonecypher"
  ],
  "homepage": "https://github.com/StoneCypher/self-expression#readme",
  "bugs": {
    "url": "https://github.com/StoneCypher/self-expression/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StoneCypher/self-expression.git"
  },
  "license": "MIT",
  "author": "John Haugeland <stonecypher@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "module": "dist/index.mjs",
  "main": "dist/index.cjs",
  "bin": {
    "self-expression": "dist/cli.cjs",
    "self-expression-audio": "dist/claudio.cjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "default": "./dist/index.mjs"
      }
    }
  },
  "directories": {
    "doc": "docs"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "src/doc_md/reference",
    "hooks",
    "claude-commands",
    "commands",
    ".claude-plugin",
    ".codex-plugin",
    "gemini-extension.json",
    ".mcp.json"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "clean": "node src/build_js/clean.js",
    "update_madlibs": "node src/build_js/update_madlibs.js --copy-readme-to docs",
    "typescript": "tsc --build tsconfig.json",
    "terser": "node src/build_js/minify_bundles.js && cp dist/index.iife.js dist/index.iife.js.map docs",
    "dts": "node src/build_js/copy_dts.js",
    "rollup": "rollup -c",
    "site": "cp src/html/* docs && cp src/html/.nojekyll docs && cp README.md docs/ && cp dist/index.mjs docs/docs/ && cp src/html/*.png docs/docs",
    "docs": "typedoc src/ts/index.ts --options typedoc-options.cjs --out docs/docs",
    "test": "npm run build",
    "stryker": "npx stryker run",
    "just_test": "vitest run --coverage && vitest run --config vitest-stoch.config.ts --coverage && vitest run --config vitest-stoch.mutat.ts --coverage",
    "just_test_save": "node src/build_js/run_tests_save.js",
    "eslint": "eslint",
    "attw": "attw --pack .",
    "cloc": "node src/build_js/run_cloc.js && node ./src/build_js/cloc_report.cjs",
    "changelog": "rm -f CHANGELOG.md && rm -f CHANGELOG.long.md && rm -f ./src/doc_md/CHANGELOG.md && rm -f ./src/doc_md/CHANGELOG.long.md && better_git_changelog -b && cp CHANGELOG.* ./src/doc_md/",
    "build": "node src/build_js/run_build.js",
    "ci": "echo starting && node -e \"console.log(new Date().toLocaleString())\" && npm run build -- --profile=ci && echo finishing && node -e \"console.log(new Date().toLocaleString())\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@faker-js/faker": "^10.6.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "better_git_changelog": "^1.6.21",
    "cloc": "^2.6.0-cloc",
    "commitlint": "^21.2.2",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "terser": "^5.51.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-coverage": "^4.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "typescript-language-server": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  }
}
